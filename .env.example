# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Anon / publishable key — browser-safe, used only for Realtime + signed uploads
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role / secret key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (https://aistudio.google.com/apikey) — SERVER ONLY
GEMINI_API_KEY=
# Optional: override the model
# GEMINI_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.8-flash
